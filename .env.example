# DFAC AgriDEP Environment Configuration

# Django
DJANGO_SECRET_KEY=change-me-in-production-use-a-strong-secret-key-32chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL URL e.g. postgres://user:password@localhost:5432/agridep)
# If left blank, falls back to SQLite for local zero-dependency testing
DATABASE_URL=

# Redis (for Celery and Caching)
REDIS_URL=redis://127.0.0.1:6379/0

# Field-Level Encryption Key (Base64-encoded 32-byte Fernet key)
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=c2VjdXJlLWtleS1mb3ItZGV2LWZlcm5ldC1lbmNyeXB0aW9uLTEyMw==

# Africa's Talking (SMS / USSD)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=mock-api-key
AFRICASTALKING_SENDER_ID=DFAC-ALERT
SMS_PROVIDER=console  # 'console' for local dev/testing, 'africastalking' for production

# Dokku / Production Static & Media
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media
