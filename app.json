{
  "name": "agridep",
  "description": "Doctor Fish Agricultural Consult (DFAC) AgriDEP Platform",
  "keywords": ["agriculture", "nigeria", "aquaculture", "django", "dokku"],
  "healthchecks": {
    "web": [
      {
        "type": "startup",
        "name": "healthcheck",
